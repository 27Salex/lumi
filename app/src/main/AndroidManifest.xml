<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Descarga de Gemma y Gemini cloud (opcional) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- «Oye Lumi»: escucha en primer plano + abrir el asistente sobre otras apps al oír la palabra -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Recordatorios -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Google Calendar a través del calendario del sistema (Agenda + citas como eventos) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Avisos por lugar («cuando llegue a casa»): geovallas, también con la app cerrada -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Actualizaciones en directo (Android 16 / Now Bar de Samsung) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Modo agente: llamar a contactos por nombre, alarmas y temporizadores -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Rutinas: «buenas noches» activa No molestar (el usuario da el acceso una vez) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Reconocimiento de voz: necesario para consultar el servicio en Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- «Cómo llegar»: ver qué apps de mapas hay (Google Maps, Waze…) y la voz del sistema -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.waze" />
        <!-- «Abre X»: ver las apps instaladas; música, búsqueda, llamadas y WhatsApp -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <!-- allowBackup=false: la API key de Gemini no debe viajar en copias de seguridad -->
    <application
        android:name=".TaskManagerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GeminiNanoTaskManager">

        <!--
            GPU de Gemma (LiteRT-LM): desde Android 12 las librerías nativas del fabricante no son visibles
            para las apps salvo que se declaren. Sin esto: "Can not find OpenCL library on this device".
        -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Panel del asistente (estilo Gemini). ACTION_ASSIST hace que la app aparezca en
            Ajustes → Aplicaciones predeterminadas → Asistente digital; así se abre con el botón
            lateral / gesto de esquina sobre cualquier app. Tarea propia para no arrastrar la app principal.
        -->
        <activity
            android:name=".presentation.assistant.AssistantActivity"
            android:exported="true"
            android:label="@string/assistant_label"
            android:theme="@style/Theme.GeminiNanoTaskManager.Assistant"
            android:taskAffinity=".assistant"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Compartir → Lumi desde cualquier app (textos y enlaces) -->
            <intent-filter android:label="Añadir a Lumi">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Tile de Ajustes rápidos -->
        <service
            android:name=".service.LumiTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_assistant"
            android:label="Lumi"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- «Oye Lumi»: palabra de activación offline (solo si el usuario la activa en Ajustes) -->
        <service
            android:name=".service.wakeword.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".service.reminder.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.place.PlaceReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.live.LiveUpdateReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.checkin.CheckInReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.checkin.MorningReceiver"
            android:exported="false" />

        <!-- «¿Qué me han escrito?»: lee las notificaciones de mensajes (solo si el usuario da el acceso) -->
        <service
            android:name=".service.notify.LumiNotificationListener"
            android:exported="true"
            android:label="Lumi · leer mensajes"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Diagnóstico del detector «Oye Lumi»: solo lo puede llamar adb/el sistema (permiso DUMP), nunca otra app -->
        <receiver
            android:name=".service.wakeword.WakeSelfTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name=".presentation.widget.QuickTaskWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_task_widget_info" />
        </receiver>

    </application>

</manifest>
