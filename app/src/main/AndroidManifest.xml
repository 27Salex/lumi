<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gemma download and Gemini cloud (optional) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app update (#11): hands the downloaded APK to the system installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- "Oye Lumi": foreground listening + opening the assistant over other apps when the phrase is heard -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Reminders -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- My PC (view only): the platform BiometricPrompt that unlocks each viewing session -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Google Calendar through the system calendar (Agenda + appointments as events) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Place reminders ("when I get home"): geofences, also with the app closed -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Live updates (Android 16 / Samsung Now Bar) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Agent mode: calling contacts by name, alarms and timers -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Routines: "good night" turns on Do Not Disturb (the user grants access once) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- "Set the brightness": granted by the user on a system screen (Modify system settings) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Speech recognition: needed to query the service on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- "Directions": see which maps apps exist (Google Maps, Waze…) and the system TTS -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.waze" />
        <!-- "Open X": see installed apps; music, search, calls and WhatsApp -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <!-- allowBackup=false: the Gemini API key must not travel in system backups (Lumi has its own backup) -->
    <application
        android:name=".TaskManagerApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumi">

        <!--
            Gemma on GPU (LiteRT-LM): since Android 12, vendor native libraries aren't visible to apps unless
            declared. Without this: "Can not find OpenCL library on this device".
        -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Assistant panel (Gemini style). ACTION_ASSIST makes the app appear in Settings → Default apps →
            Digital assistant, so it opens with the side button / corner gesture over any app. Its own task so it
            doesn't drag the main app along.
        -->
        <activity
            android:name=".presentation.assistant.AssistantActivity"
            android:exported="true"
            android:label="@string/assistant_label"
            android:theme="@style/Theme.Lumi.Assistant"
            android:taskAffinity=".assistant"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Share → Lumi from any app (text and links) -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tile -->
        <service
            android:name=".service.LumiTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_assistant"
            android:label="Lumi"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- "Oye Lumi": offline wake word (only if the user turns it on in Settings) -->
        <service
            android:name=".service.wakeword.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".service.reminder.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.place.PlaceReceiver"
            android:exported="false" />

        <!-- Lumi Hub notification buttons (answer an agent, add / dismiss a proposed task) -->
        <receiver
            android:name=".service.hub.HubActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.live.LiveUpdateReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.checkin.CheckInReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.checkin.MorningReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.checkin.BedtimeReceiver"
            android:exported="false" />

        <!-- "What did they write to me?": reads message notifications (only if the user grants access) -->
        <service
            android:name=".service.notify.LumiNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- "Oye Lumi" detector diagnostics: only adb/the system can call it (DUMP permission), never another app -->
        <receiver
            android:name=".service.wakeword.WakeSelfTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name=".presentation.widget.QuickTaskWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_task_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>
